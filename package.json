{
  "name": "expectbox-agents",
  "version": "0.2.1",
  "description": "Scoped email inboxes for agents: Expectbox SDK and MCP server for JavaScript and TypeScript",
  "type": "module",
  "main": "./js/expectbox.mjs",
  "types": "./js/expectbox.d.mts",
  "bin": {
    "expectbox-mcp": "./js/mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./js/expectbox.d.mts",
      "import": "./js/expectbox.mjs",
      "default": "./js/expectbox.mjs"
    }
  },
  "files": [
    "js/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simon86pl/expectbox-sdk.git"
  },
  "homepage": "https://www.expectbox.com/",
  "bugs": "https://github.com/simon86pl/expectbox-sdk/issues",
  "publishConfig": {
    "access": "public"
  }
}
